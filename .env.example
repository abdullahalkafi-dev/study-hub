# Copy to .env and fill in. .env is gitignored: NEVER commit real values. This file holds placeholders only.

# --- Database: MongoDB Atlas (required) -----------------------------------
# <db_username> and <db_password> are filled in from MONGODB_USER and MONGODB_PASSWORD below.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB_NAME=silo-study

# --- Login (REQUIRED on a VPS, optional on your own PC) --------------------
# The API refuses to start in production without all three.
LEARNER_EMAIL=
LEARNER_PASSWORD=
# Any long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Set to true once the site is served over HTTPS (so the login cookie is HTTPS-only).
COOKIE_SECURE=false

# --- File storage (MinIO) for image/audio/video uploads --------------------
# Choose any long random values. The same two values start MinIO and let the API log in to it.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=silo-uploads
# Only for `npm run dev` outside Docker (inside Docker the API uses the "minio" service):
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false

# --- Ports and URLs ---------------------------------------------------------
API_PORT=4000
# Used by `npm run dev` (Next.js proxies /api to this address). In Docker it is set at build time.
API_URL=http://localhost:4000
WEB_PORT=3000
# The public address of the site (also allowed by the API's CORS list).
PUBLIC_URL=http://localhost:3000

# --- Optional HTTPS with Caddy (docker compose --profile proxy up -d) ------
DOMAIN=
